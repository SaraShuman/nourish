# Nourish server-side environment variables.
# Copy this file to `.env` (which is gitignored) and fill in real values.
# These are read ONLY by the dev-server proxy / serverless function and are
# NEVER bundled into client code or exposed to the browser.

# Contact email sent in the Open Food Facts User-Agent (OFF usage policy).
OFF_CONTACT=you@example.com

# Google Places API (New) key — used by the proxy to discover real nearby
# stores. Restrict the key to "Places API (New)" only, and set a billing
# budget alert + a daily request quota in Google Cloud. Do NOT commit the key.
GOOGLE_PLACES_KEY=your-google-places-api-key
